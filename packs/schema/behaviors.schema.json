{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cutsy v1 behavior recipes",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "behaviors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
          },
          "family": {
            "enum": [
              "idle",
              "movement",
              "edge",
              "reaction"
            ]
          },
          "selectionWeight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          },
          "cooldownMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3600000
          },
          "requiredCapabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            },
            "minItems": 0,
            "maxItems": 16
          },
          "eligibility": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "surfaceKind": {
                "enum": [
                  "floor",
                  "windowTop",
                  "windowLeft",
                  "windowRight",
                  "windowBottom"
                ]
              },
              "facing": {
                "enum": [
                  "none",
                  "front",
                  "left",
                  "right"
                ]
              },
              "grounded": {
                "type": "boolean"
              },
              "attached": {
                "type": "boolean"
              },
              "interaction": {
                "enum": [
                  "click",
                  "pickup",
                  "drop"
                ]
              },
              "minimumWidth": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              }
            }
          },
          "interruptPolicy": {
            "enum": [
              "interruptible",
              "finish",
              "loop"
            ]
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": [
                    "playFrames",
                    "hold",
                    "moveAlongSurface",
                    "jump",
                    "fall",
                    "attach",
                    "detach",
                    "react",
                    "playSound"
                  ]
                },
                "durationMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 120000
                },
                "spriteId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
                },
                "frames": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "spriteId": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
                      },
                      "durationMs": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 120000
                      }
                    },
                    "required": [
                      "spriteId",
                      "durationMs"
                    ]
                  },
                  "minItems": 1,
                  "maxItems": 64
                },
                "speed": {
                  "type": "number",
                  "minimum": -5,
                  "maximum": 5
                },
                "height": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 4
                },
                "target": {
                  "enum": [
                    "floor",
                    "windowTop",
                    "windowLeft",
                    "windowRight",
                    "windowBottom"
                  ]
                },
                "anchor": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
                },
                "soundId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
                },
                "clip": {
                  "type": "boolean"
                }
              },
              "required": [
                "type"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "playFrames"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "frames"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "attach"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "target"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "playSound"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "soundId"
                    ]
                  }
                }
              ]
            },
            "minItems": 1,
            "maxItems": 64
          },
          "next": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "behaviorId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
                },
                "weight": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000
                }
              },
              "required": [
                "behaviorId",
                "weight"
              ]
            },
            "minItems": 0,
            "maxItems": 32
          }
        },
        "required": [
          "id",
          "family",
          "selectionWeight",
          "cooldownMs",
          "requiredCapabilities",
          "eligibility",
          "interruptPolicy",
          "steps",
          "next"
        ]
      },
      "minItems": 1,
      "maxItems": 160
    }
  },
  "required": [
    "schemaVersion",
    "behaviors"
  ]
}
