{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cutsy v1 pack",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "referenceHeightPx": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2048
    },
    "defaultBehaviorId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "sprites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
          },
          "path": {
            "type": "string",
            "maxLength": 180,
            "pattern": "^([A-Za-z0-9][A-Za-z0-9_.-]*/)*[A-Za-z0-9][A-Za-z0-9_.-]*\\.png$"
          },
          "sourceAssetId": {
            "type": "string",
            "minLength": 1
          },
          "facing": {
            "enum": [
              "none",
              "front",
              "left",
              "right"
            ]
          },
          "contentBounds": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2047
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2047
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2048
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2048
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ]
          },
          "anchors": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 12,
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2048
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2048
                }
              },
              "required": [
                "x",
                "y"
              ]
            }
          },
          "scaleCorrection": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 4
          },
          "maskPath": {
            "type": "string",
            "maxLength": 180,
            "pattern": "^([A-Za-z0-9][A-Za-z0-9_.-]*/)*[A-Za-z0-9][A-Za-z0-9_.-]*\\.png$"
          },
          "bakedInProps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "maxItems": 20
          }
        },
        "required": [
          "id",
          "path",
          "sourceAssetId",
          "facing",
          "contentBounds",
          "anchors",
          "scaleCorrection",
          "maskPath"
        ]
      },
      "minItems": 1,
      "maxItems": 160
    },
    "sounds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
          },
          "path": {
            "type": "string",
            "maxLength": 180,
            "pattern": "^([A-Za-z0-9][A-Za-z0-9_.-]*/)*[A-Za-z0-9][A-Za-z0-9_.-]*\\.wav$"
          },
          "gain": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "path",
          "gain"
        ]
      },
      "minItems": 0,
      "maxItems": 32
    },
    "behaviorFile": {
      "type": "string",
      "maxLength": 180,
      "pattern": "^([A-Za-z0-9][A-Za-z0-9_.-]*/)*[A-Za-z0-9][A-Za-z0-9_.-]*\\.json$"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "version",
    "referenceHeightPx",
    "defaultBehaviorId",
    "sprites",
    "sounds",
    "behaviorFile"
  ]
}
